# =============================================================================
# GASGUARD REMOTE HARDWARE GATEWAY ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
#
# Server Origin & Loopback Bind
GASGUARD_HOST=127.0.0.1
GASGUARD_PORT=5567

# Trusted Cloudflare Tunnel Deployment Mode
GASGUARD_TRUSTED_TUNNEL_MODE=true

# Explicit Expected Public Device Hostname (e.g. device-api.example.com)
# Hostname must match public reverse proxy hostname exactly (no trailing slash/port)
GASGUARD_PUBLIC_DEVICE_HOST=device-api.example.com

# Insecure Development Override (DEFAULT: false - KEEP FALSE FOR REMOTE HARDWARE PILOT)
GASGUARD_ALLOW_INSECURE_ENROLLMENT=false

# Supabase Real Device Authentication (Server-Side Only)
# GASGUARD_SUPABASE_URL=https://<your-project-id>.supabase.co
# GASGUARD_SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# =============================================================================
# FIRMWARE COMPILE CONFIGURATION (NOT IN SERVER ENV — EMBEDDED IN ESP32 BUILD)
# =============================================================================
# GASGUARD_INGRESS_URL="https://device-api.example.com/api/v1/device/telemetry"
# GASGUARD_ENROLLMENT_URL="https://device-api.example.com/api/v1/device/enroll"
# GASGUARD_INGRESS_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
