# Server-only configuration. Copy values into your shell environment; do not commit real keys.
GASGUARD_HOST=127.0.0.1
GASGUARD_PORT=5567
GASGUARD_REAL_DEVICE_KEY=<SET_REAL_DEVICE_KEY>
GASGUARD_TEST_DEVICE_KEY=<SET_TEST_DEVICE_KEY>

# Firmware values belong in firmware/esp32-handshake/secrets.h (git-ignored):
# GASGUARD_WIFI_SSID=<WIFI_SSID>
# GASGUARD_WIFI_PASSWORD=<WIFI_PASSWORD>
# GASGUARD_SERVER_URL=http://<LAN_IP>:5567/api/v1/device/telemetry
# GASGUARD_DEVICE_KEY=<SAME_REAL_DEVICE_KEY>
